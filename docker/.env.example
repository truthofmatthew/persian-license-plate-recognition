# Copy to docker/.env and fill in. Generate tokens with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PLPR_ADMIN_TOKEN=
PLPR_RETENTION_DAYS=90
PLPR_CORS_ORIGINS=["http://localhost:5173"]

# Camera (placeholder) and edge agent
GATE1_RTSP_URL=rtsp://user:password@192.168.1.64:554/stream1
AGENT_GATE_ID=1
PLPR_AGENT_TOKEN=
PLPR_RELAY_URL=

# Only with --profile postgres
POSTGRES_PASSWORD=
# PLPR_DATABASE_URL=postgresql+psycopg://plpr:<password>@postgres:5432/plpr
